# Copy this file to .env and replace the placeholder:
#     cp .env.example .env
# .env is listed in .gitignore. Never commit it, and never paste the key into code.

# Required: the Claude API key provided by your supervisor (starts with "sk-ant-").
ANTHROPIC_API_KEY=your-api-key-here

# Optional: model to call. Default: claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Optional: server-side refusal fallback (beta). Default: true.
# Set to false if the API answers 400 about the "anthropic-beta" header.
# CLAUDE_USE_FALLBACKS=true
